# 12. Validation Tests

## 12.1 Pre-flight Validation Test

```yaml
# tests/validation/preflight.yml
---
- name: Pre-flight Validation Test
  hosts: nexus
  become: true
  tasks:
    - name: Run validation
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_validation
      vars:
        nexus_validation_enabled: true
        nexus_validation_fail_on_error: true

    - name: Test duplicate detection
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_validation
      vars:
        nexus_repos:
          - name: duplicate-repo
            format: maven2
            type: hosted
          - name: duplicate-repo
            format: maven2
            type: hosted
        nexus_validation_check_duplicate_repos: true
        nexus_validation_fail_on_error: false
      register: validation_result
      ignore_errors: true

    - name: Verify duplicate detected
      ansible.builtin.assert:
        that:
          - validation_result is failed
```

## 12.2 Credential Validation Test

```yaml
# tests/validation/credentials.yml
---
- name: Credential Validation Test
  hosts: nexus
  become: true
  tasks:
    - name: Test missing admin password
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_validation
      vars:
        nexus_admin_password: ""
        nexus_validation_check_admin_password: true
        nexus_validation_fail_on_error: true
      register: validation_result
      ignore_errors: true

    - name: Verify validation failed
      ansible.builtin.assert:
        that:
          - validation_result is failed
```

## 12.3 Format Validation Test

```yaml
# tests/validation/formats.yml
---
- name: Format Validation Test
  hosts: nexus
  become: true
  tasks:
    - name: Test invalid format detection
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_validation
      vars:
        nexus_repos:
          - name: test-repo
            format: invalid-format
            type: hosted
        nexus_validation_check_repo_formats: true
        nexus_validation_fail_on_error: false
      register: validation_result
      ignore_errors: true

    - name: Verify invalid format detected
      ansible.builtin.assert:
        that:
          - validation_result is failed
```

