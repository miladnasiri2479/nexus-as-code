## 4.2 Upgrade Scenario

### molecule/upgrade/molecule.yml

```yaml
---
dependency:
  name: galaxy
driver:
  name: docker
platforms:
  - name: nexus-upgrade-test
    image: geerlingguy/docker-ubuntu2204-ansible
    pre_build_image: true
    privileged: true
    volumes:
      - /sys/fs/cgroup:/sys/fs/cgroup:rw
    cgroupns_mode: host
    command: /lib/systemd/systemd
provisioner:
  name: ansible
  inventory:
    group_vars:
      all:
        nexus_admin_password: admin123
        nexus_port: 8081
verifier:
  name: ansible
```

### molecule/upgrade/converge.yml

```yaml
---
- name: Converge - Install initial version
  hosts: all
  become: true
  roles:
    - role: nexus-as-code.common
    - role: nexus-as-code.java
    - role: nexus-as-code.nexus_install
  vars:
    nexus_version: "3.71.0"

- name: Converge - Upgrade to new version
  hosts: all
  become: true
  roles:
    - role: nexus-as-code.nexus_upgrade
  vars:
    nexus_version: "3.72.0"
    nexus_upgrade_backup_before: true
    nexus_upgrade_verify_version: true
```

---

## 4.3 Backup-Restore Scenario

### molecule/backup-restore/converge.yml

```yaml
---
- name: Converge - Deploy Nexus
  hosts: all
  become: true
  roles:
    - role: nexus-as-code.common
    - role: nexus-as-code.java
    - role: nexus-as-code.nexus_install
    - role: nexus-as-code.nexus_config
    - role: nexus-as-code.nexus_blobstores
    - role: nexus-as-code.nexus_repos

- name: Converge - Run backup
  hosts: all
  become: true
  roles:
    - role: nexus-as-code.nexus_backup
  vars:
    nexus_backup_enabled: true
    nexus_backup_dir: /var/nexus/backup

- name: Converge - Restore from backup
  hosts: all
  become: true
  roles:
    - role: nexus-as-code.nexus_restore
  vars:
    nexus_restore_source: "/var/nexus/backup/nexus-backup-*.tar.gz"
    nexus_restore_validate: true
    nexus_restore_post_check: true
```

