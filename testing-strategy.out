# 7. Upgrade Tests

## 7.1 Version Upgrade Test

```yaml
# tests/upgrade/version_upgrade.yml
---
- name: Upgrade Test
  hosts: nexus
  become: true
  tasks:
    - name: Install initial version
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_install
      vars:
        nexus_version: "3.71.0"

    - name: Verify initial version
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/status"
        method: GET
        status_code: 200

    - name: Upgrade to new version
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_upgrade
      vars:
        nexus_version: "3.72.0"
        nexus_upgrade_backup_before: true
        nexus_upgrade_verify_version: true

    - name: Verify upgraded version
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/status"
        method: GET
        status_code: 200

    - name: Verify data preserved
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/repositories"
        method: GET
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200
      register: repos_after_upgrade

    - name: Assert repositories preserved
      ansible.builtin.assert:
        that:
          - repos_after_upgrade.json | length > 0
```

## 7.2 Rollback Test

```yaml
# tests/upgrade/rollback.yml
---
- name: Rollback Test
  hosts: nexus
  become: true
  tasks:
    - name: Deploy initial version
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_deploy
      vars:
        nexus_version: "3.71.0"

    - name: Create backup
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_backup
      vars:
        nexus_backup_enabled: true

    - name: Upgrade (simulate failure)
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_upgrade
      vars:
        nexus_version: "3.72.0"
      ignore_errors: true
      register: upgrade_result

    - name: Restore from backup
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_restore
      vars:
        nexus_restore_source: "/var/nexus/backup/nexus-backup-*.tar.gz"
        nexus_restore_validate: true
      when: upgrade_result is failed
```

---

# 8. Disaster Recovery Tests

## 8.1 Full Restore Test

```yaml
# tests/disaster_recovery/full_restore.yml
---
- name: Full Restore Test
  hosts: nexus
  become: true
  tasks:
    - name: Deploy Nexus with data
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_deploy

    - name: Create test data
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/repositories"
        method: POST
        body_format: json
        body:
          name: test-repo
          format: maven2
          type: hosted
          write_policy: allow_once
          blob_store_name: default
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: [200, 201]

    - name: Backup Nexus
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_backup
      vars:
        nexus_backup_enabled: true

    - name: Simulate disaster (stop service)
      ansible.builtin.systemd:
        name: nexus
        state: stopped

    - name: Destroy data
      ansible.builtin.file:
        path: "{{ nexus_data_dir }}"
        state: absent

    - name: Restore from backup
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_restore
      vars:
        nexus_restore_source: "/var/nexus/backup/nexus-backup-*.tar.gz"
        nexus_restore_validate: true

    - name: Verify data restored
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/repositories"
        method: GET
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200
      register: repos_after_restore

    - name: Assert test repo exists
      ansible.builtin.assert:
        that:
          - "'test-repo' in (repos_after_restore.json | map(attribute='name') | list)"
```

## 8.2 Partial Restore Test

```yaml
# tests/disaster_recovery/partial_restore.yml
---
- name: Partial Restore Test
  hosts: nexus
  become: true
  tasks:
    - name: Deploy Nexus
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_deploy

    - name: Create multiple repositories
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/repositories/maven2/hosted"
        method: POST
        body_format: json
        body:
          name: "{{ item }}"
          format: maven2
          type: hosted
          write_policy: allow_once
          blob_store_name: default
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: [200, 201]
      loop:
        - repo-1
        - repo-2
        - repo-3

    - name: Backup
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_backup
      vars:
        nexus_backup_enabled: true

    - name: Delete one repository
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/repositories/repo-2"
        method: DELETE
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: [200, 204]

    - name: Restore
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_restore
      vars:
        nexus_restore_source: "/var/nexus/backup/nexus-backup-*.tar.gz"

    - name: Verify all repositories restored
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/repositories"
        method: GET
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200
      register: repos

    - name: Assert all repos exist
      ansible.builtin.assert:
        that:
          - "'repo-1' in (repos.json | map(attribute='name') | list)"
          - "'repo-2' in (repos.json | map(attribute='name') | list)"
          - "'repo-3' in (repos.json | map(attribute='name') | list)"
```

