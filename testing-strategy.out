# 9. S3 Tests

## 9.1 S3 Blobstore Creation Test

```yaml
# tests/s3/blobstore_creation.yml
---
- name: S3 Blobstore Test
  hosts: nexus
  become: true
  tasks:
    - name: Configure S3 storage
      ansible.builtin.include_role:
        name: nexus-as-code.storage_s3
      vars:
        nexus_storage_s3_enabled: true
        nexus_storage_s3_region: us-east-1
        nexus_storage_s3_bucket_prefix: test-nexus
        nexus_storage_s3_access_key_id: "{{ vault_s3_access_key }}"
        nexus_storage_s3_secret_access_key: "{{ vault_s3_secret_key }}"
        nexus_storage_s3_endpoint: "https://s3.amazonaws.com"

    - name: Verify S3 blobstore exists
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/blobstores/test-nexus-s3"
        method: GET
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200

    - name: Create repository on S3
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/repositories/maven2/hosted"
        method: POST
        body_format: json
        body:
          name: s3-maven-releases
          format: maven2
          type: hosted
          write_policy: allow_once
          blob_store_name: test-nexus-s3
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: [200, 201]

    - name: Verify repository uses S3
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/repositories/s3-maven-releases"
        method: GET
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200
      register: repo

    - name: Assert blob store is S3
      ansible.builtin.assert:
        that:
          - repo.json.blob_store_name == "test-nexus-s3"
```

## 9.2 S3 Bucket Creation Test

```yaml
# tests/s3/bucket_creation.yml
---
- name: S3 Bucket Creation Test
  hosts: nexus
  become: true
  tasks:
    - name: Create S3 buckets
      ansible.builtin.include_role:
        name: nexus-as-code.storage_bucket_create
      vars:
        nexus_buckets:
          - name: test-bucket-1
            versioning: false
          - name: test-bucket-2
            versioning: true

    - name: Verify buckets exist
      ansible.builtin.shell: |
        /usr/local/bin/mc ls {{ nexus_minio_alias }}/test-bucket-1 >/dev/null 2>&1
      changed_when: false

    - name: Verify versioning enabled
      ansible.builtin.shell: |
        /usr/local/bin/mc version info {{ nexus_minio_alias }}/test-bucket-2 | grep -q "enabled"
      changed_when: false
```

