# 14. Failure Scenarios

## 14.1 Network Failure Test

```yaml
# tests/failure/network_failure.yml
---
- name: Network Failure Test
  hosts: nexus
  become: true
  tasks:
    - name: Simulate network failure
      ansible.builtin.iptables:
        chain: OUTPUT
        protocol: tcp
        destination_port: "8081"
        jump: DROP
      become: true
      ignore_errors: true

    - name: Attempt deployment (should fail)
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_validation
      vars:
        nexus_validation_fail_on_error: true
      register: validation_result
      ignore_errors: true

    - name: Restore network
      ansible.builtin.iptables:
        chain: OUTPUT
        protocol: tcp
        destination_port: "8081"
        jump: DROP
        state: absent
      become: true
      ignore_errors: true

    - name: Verify validation failed
      ansible.builtin.assert:
        that:
          - validation_result is failed
```

## 14.2 Service Failure Test

```yaml
# tests/failure/service_failure.yml
---
- name: Service Failure Test
  hosts: nexus
  become: true
  tasks:
    - name: Stop Nexus service
      ansible.builtin.systemd:
        name: nexus
        state: stopped

    - name: Attempt health check (should fail)
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/status"
        method: GET
        status_code: 200
      register: health_check
      retries: 3
      delay: 5
      until: health_check.status == 200
      ignore_errors: true

    - name: Verify health check failed
      ansible.builtin.assert:
        that:
          - health_check is failed

    - name: Restart Nexus service
      ansible.builtin.systemd:
        name: nexus
        state: started

    - name: Verify Nexus is running
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/status"
        method: GET
        status_code: 200
```

## 14.3 Permission Failure Test

```yaml
# tests/failure/permission_failure.yml
---
- name: Permission Failure Test
  hosts: nexus
  become: true
  tasks:
    - name: Test wrong password
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/repositories"
        method: GET
        user: admin
        password: wrongpassword
        force_basic_auth: true
        status_code: 200
      register: auth_result
      ignore_errors: true

    - name: Verify auth failed
      ansible.builtin.assert:
        that:
          - auth_result is failed
```

## 14.4 Disk Space Failure Test

```yaml
# tests/failure/disk_space.yml
---
- name: Disk Space Failure Test
  hosts: nexus
  become: true
  tasks:
    - name: Check disk space
      ansible.builtin.shell: |
        df -BG {{ nexus_data_dir }} | awk 'NR==2{print $5}' | tr -d '%'
      register: disk_usage
      changed_when: false

    - name: Warn if disk usage high
      ansible.builtin.debug:
        msg: "Disk usage: {{ disk_usage.stdout }}%"
      when: disk_usage.stdout | int > 80
```

