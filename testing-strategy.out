        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200

    - name: Test API blobstores endpoint
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/blobstores"
        method: GET
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200

    - name: Test API users endpoint
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/security/users"
        method: GET
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200

    - name: Test API roles endpoint
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/security/roles"
        method: GET
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200
```

