# 10. MinIO Tests

## 10.1 MinIO Installation Test

```yaml
# tests/minio/installation.yml
---
- name: MinIO Installation Test
  hosts: nexus
  become: true
  tasks:
    - name: Install MinIO
      ansible.builtin.include_role:
        name: nexus-as-code.storage_minio
      vars:
        nexus_minio_enabled: true
        nexus_minio_access_key: minioadmin
        nexus_minio_secret_key: minioadmin

    - name: Verify MinIO service is running
      ansible.builtin.systemd:
        name: minio
      register: minio_service

    - name: Assert MinIO is active
      ansible.builtin.assert:
        that:
          - minio_service.status.ActiveState == "active"

    - name: Verify MinIO health endpoint
      ansible.builtin.uri:
        url: "http://localhost:{{ nexus_minio_port }}/minio/health/live"
        method: GET
        status_code: 200
```

## 10.2 MinIO Bucket Test

```yaml
# tests/minio/buckets.yml
---
- name: MinIO Bucket Test
  hosts: nexus
  become: true
  tasks:
    - name: Install MinIO
      ansible.builtin.include_role:
        name: nexus-as-code.storage_minio
      vars:
        nexus_minio_enabled: true
        nexus_minio_access_key: minioadmin
        nexus_minio_secret_key: minioadmin

    - name: Create buckets
      ansible.builtin.include_role:
        name: nexus-as-code.storage_bucket_create
      vars:
        nexus_buckets:
          - name: test-bucket
            versioning: true

    - name: Verify bucket exists
      ansible.builtin.shell: |
        /usr/local/bin/mc ls {{ nexus_minio_alias }}/test-bucket >/dev/null 2>&1
      changed_when: false

    - name: Test bucket connectivity
      ansible.builtin.shell: |
        echo "test" | /usr/local/bin/mc pipe {{ nexus_minio_alias }}/test-bucket/test.txt
      changed_when: false

    - name: Verify test file
      ansible.builtin.shell: |
        /usr/local/bin/mc cat {{ nexus_minio_alias }}/test-bucket/test.txt | grep -q "test"
      changed_when: false

    - name: Cleanup test file
      ansible.builtin.shell: |
        /usr/local/bin/mc rm {{ nexus_minio_alias }}/test-bucket/test.txt
      changed_when: false
```

