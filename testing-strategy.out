# 11. Proxy Tests

## 11.1 HTTP Proxy Test

```yaml
# tests/proxy/http_proxy.yml
---
- name: HTTP Proxy Test
  hosts: nexus
  become: true
  tasks:
    - name: Configure proxy
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_proxy
      vars:
        nexus_proxy_enabled: true
        nexus_http_proxy_host: proxy.example.com
        nexus_http_proxy_port: 3128
        nexus_http_proxy_username: proxyuser
        nexus_http_proxy_password: proxypass

    - name: Verify proxy configuration
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/security/proxy"
        method: GET
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200
      register: proxy_config

    - name: Assert proxy is configured
      ansible.builtin.assert:
        that:
          - proxy_config.json.httpProxyHost == "proxy.example.com"

    - name: Verify environment variables
      ansible.builtin.shell: |
        grep -q "HTTP_PROXY=proxy.example.com" /etc/default/nexus
      changed_when: false
```

## 11.2 No Proxy Test

```yaml
# tests/proxy/no_proxy.yml
---
- name: No Proxy Test
  hosts: nexus
  become: true
  tasks:
    - name: Configure proxy with no_proxy
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_proxy
      vars:
        nexus_proxy_enabled: true
        nexus_http_proxy_host: proxy.example.com
        nexus_http_proxy_port: 3128
        nexus_no_proxy_hosts: "localhost,127.0.0.1,.internal.example.com"

    - name: Verify no_proxy in environment
      ansible.builtin.shell: |
        grep -q "NO_PROXY=localhost,127.0.0.1,.internal.example.com" /etc/default/nexus
      changed_when: false
```

