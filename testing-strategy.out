# 4. Molecule Tests

## 4.1 Default Scenario

### molecule.yml

```yaml
---
dependency:
  name: galaxy
driver:
  name: docker
platforms:
  - name: nexus-test
    image: geerlingguy/docker-ubuntu2204-ansible
    pre_build_image: true
    privileged: true
    volumes:
      - /sys/fs/cgroup:/sys/fs/cgroup:rw
    cgroupns_mode: host
    command: /lib/systemd/systemd
    docker_networks:
      - name: nexus-test
        driver: bridge
    networks:
      - name: nexus-test
    published_ports:
      - "8081:8081"
provisioner:
  name: ansible
  inventory:
    group_vars:
      all:
        nexus_admin_password: admin123
        nexus_version: "3.72.0"
        nexus_port: 8081
verifier:
  name: ansible
```

### converge.yml

```yaml
---
- name: Converge - Full deployment
  hosts: all
  become: true
  roles:
    - role: nexus-as-code.common
    - role: nexus-as-code.java
    - role: nexus-as-code.nexus_install
    - role: nexus-as-code.nexus_config
    - role: nexus-as-code.nexus_blobstores
    - role: nexus-as-code.nexus_repos
    - role: nexus-as-code.nexus_repos_groups
    - role: nexus-as-code.nexus_cleanup
    - role: nexus-as-code.nexus_security
    - role: nexus-as-code.nexus_validation
```

### verify.yml

```yaml
---
- name: Verify deployment
  hosts: all
  become: true
  tasks:
    - name: Check Nexus service is running
      ansible.builtin.systemd:
        name: nexus
      register: nexus_service

    - name: Assert Nexus is active
      ansible.builtin.assert:
        that:
          - nexus_service.status.ActiveState == "active"

    - name: Check Nexus API health
      ansible.builtin.uri:
        url: "http://localhost:8081/service/rest/v1/status"
        method: GET
        status_code: 200
      register: nexus_health

    - name: Assert API is healthy
      ansible.builtin.assert:
        that:
          - nexus_health.status == 200

    - name: Check repository count
      ansible.builtin.uri:
        url: "http://localhost:8081/service/rest/v1/repositories"
        method: GET
        user: admin
        password: admin123
        force_basic_auth: true
        status_code: 200
      register: nexus_repos

    - name: Assert repositories exist
      ansible.builtin.assert:
        that:
          - nexus_repos.json | length > 0
```

