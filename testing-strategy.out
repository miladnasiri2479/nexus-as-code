# 5. Integration Tests

## 5.1 Full Stack Test

```yaml
# tests/integration/full_stack.yml
---
- name: Full Stack Integration Test
  hosts: nexus
  become: true
  tasks:
    - name: Deploy Nexus
      ansible.builtin.include_role:
        name: nexus-as-code.nexus_deploy

    - name: Wait for API
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/status"
        method: GET
        status_code: 200
      register: api_health
      until: api_health.status == 200
      retries: 30
      delay: 10

    - name: Verify repositories
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/repositories"
        method: GET
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200
      register: repos

    - name: Assert repositories count
      ansible.builtin.assert:
        that:
          - repos.json | length >= 5
        fail_msg: "Expected at least 5 repositories"

    - name: Verify blobstores
      ansible.builtin.uri:
        url: "http://{{ nexus_listen_address }}:{{ nexus_port }}/service/rest/v1/blobstores"
        method: GET
        user: "{{ nexus_admin_user }}"
        password: "{{ nexus_admin_password }}"
        force_basic_auth: true
        status_code: 200
      register: blobstores

    - name: Assert blobstores exist
      ansible.builtin.assert:
        that:
          - blobstores.json | length >= 1
        fail_msg: "Expected at least 1 blobstore"
```

