# roles/traefik/templates/traefik.yml.j2
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

api:
  dashboard: {{ traefik.dashboard_enabled | lower }}
  insecure: false

providers:
  docker:
    exposedByDefault: false
  file:
    directory: /dynamic
    watch: true

{% if traefik.letsencrypt | bool %}
certificatesResolvers:
  le:
    acme:
      email: {{ traefik.email }}
      storage: /acme.json
      httpChallenge:
        entryPoint: web
{% endif %}
