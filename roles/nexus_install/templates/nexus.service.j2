# =============================================================================
# Nexus Repository Manager — systemd Unit File
# Managed by Ansible — DO NOT EDIT MANUALLY
# Role: nexus_install
# =============================================================================

[Unit]
Description=Sonatype Nexus Repository Manager
Documentation=https://help.sonatype.com/repomanager3
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# User and group
User={{ nexus_runas_user }}
Group={{ nexus_runas_group }}

# Environment
EnvironmentFile=/etc/default/nexus

# Start / Stop commands
ExecStart={{ nexus_current_link }}/bin/nexus run
ExecStop={{ nexus_current_link }}/bin/nexus stop

# No PID file needed for Type=simple

# Restart policy
Restart={{ nexus_service_restart_policy }}
RestartSec={{ nexus_service_restart_sec }}

# Timeout
TimeoutStartSec={{ nexus_service_timeout_start }}
TimeoutStopSec={{ nexus_service_timeout_stop }}

# Resource limits
LimitNOFILE={{ nexus_limits_nofile }}
LimitNPROC={{ nexus_limits_nproc }}

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths={{ nexus_data_dir }}
ReadWritePaths={{ nexus_temp_dir }}
ReadWritePaths={{ nexus_work_dir }}

[Install]
WantedBy=multi-user.target
