# =============================================================================
# Docker Compose for Nexus with Traefik Labels
# Managed by Ansible — DO NOT EDIT MANUALLY
# Role: nexus_install
# =============================================================================

services:
  nexus:
    image: "{{ nexus_docker_image }}:{{ nexus_docker_tag }}"
    container_name: "{{ nexus_docker_container_name }}"
    hostname: "{{ nexus_hostname | default(inventory_hostname) }}"
    restart: "{{ nexus_docker_restart_policy }}"
    network_mode: "{{ nexus_docker_network_mode }}"

    # ── Volumes ──
    volumes:
{% for vol in nexus_docker_volumes %}
      - "{{ vol }}"
{% endfor %}

    # ── Environment ──
    environment:
      INSTALL4J_ADD_VM_PARAMS: "{{ nexus_docker_install4j | default(nexus_jvm_memory ~ ' -Djava.util.prefs.userRoot=' ~ nexus_data_dir ~ '/data/java' ~ ' -Djava.io.tmpdir=' ~ nexus_temp_dir) }}"
{% if nexus_docker_admin_password_enabled | default(false) %}
      NEXUS_SECURITY_ADMIN_PASSWORD: "{{ nexus_admin_password }}"
{% endif %}
{% for key, value in nexus_docker_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}

    # ── Resource Limits ──
{% if nexus_docker_memory_limit | default('') | length > 0 %}
    mem_limit: "{{ nexus_docker_memory_limit }}"
{% endif %}
{% if nexus_docker_cpus | default('') | length > 0 %}
    cpus: {{ nexus_docker_cpus }}
{% endif %}

    # ── Health Check ──
{% if nexus_docker_healthcheck_enabled %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081{{ nexus_api_health_path | default('/service/rest/v1/status') }}"]
      interval: "{{ nexus_docker_healthcheck_interval }}s"
      timeout: "{{ nexus_docker_healthcheck_timeout }}s"
      retries: {{ nexus_docker_healthcheck_retries }}
      start_period: "{{ nexus_docker_healthcheck_start_period }}s"
{% endif %}

    # ── Logging ──
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"

{% if nexus_traefik_enabled | default(false) %}
    # ── Traefik Labels ──
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.nexus.entrypoints=websecure"
      - "traefik.http.routers.nexus.tls.certResolver=default"
      - "traefik.http.services.nexus.loadbalancer.server.port=8081"
      - "traefik.http.services.nexus.loadbalancer.healthcheck.path=//service/rest/v1/status"
      - "traefik.http.services.nexus.loadbalancer.healthcheck.interval=30s"
      - "traefik.http.services.nexus.loadbalancer.healthcheck.timeout=10s"
{% for repo in nexus_repositories | default([]) %}
{% if repo.enabled | default(false) and repo.traefik_subdomain_prefix | default('') | length > 0 %}
      - "traefik.http.routers.{{ repo.name }}.rule=Host(`{{ repo.traefik_subdomain_prefix }}.{{ main_domain }}`)"
      - "traefik.http.routers.{{ repo.name }}.entrypoints=websecure"
      - "traefik.http.routers.{{ repo.name }}.tls.certResolver=default"
      - "traefik.http.services.{{ repo.name }}.loadbalancer.server.port=8081"
      - "traefik.http.services.{{ repo.name }}.loadbalancer.healthcheck.path=//service/rest/v1/status"
{% endif %}
{% endfor %}
{% endif %}
