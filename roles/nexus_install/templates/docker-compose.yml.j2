# =============================================================================
# Nexus Repository Manager — Docker Compose
# Managed by Ansible — DO NOT EDIT MANUALLY
# Role: nexus_install
# =============================================================================

services:
  nexus:
    image: "{{ nexus_docker_image }}:{{ nexus_docker_tag }}"
    container_name: "{{ nexus_docker_container_name }}"
    hostname: "{{ nexus_hostname | default(inventory_hostname) }}"
    restart: "{{ nexus_docker_restart_policy }}"

    # ── Network ──
    network_mode: "{{ nexus_docker_network_mode }}"
{% if nexus_docker_network_mode != 'host' %}
    ports:
{% for port in nexus_docker_ports %}
      - "{{ port }}"
{% endfor %}
{% endif %}

    # ── Volumes ──
    volumes:
{% for vol in nexus_docker_volumes %}
      - "{{ vol }}"
{% endfor %}

    # ── Environment ──
    environment:
      INSTALL4J_ADD_VM_PARAMS: "{{ nexus_docker_install4j | default(nexus_jvm_memory ~ ' -Djava.util.prefs.userRoot=' ~ nexus_data_dir ~ '/data/java' ~ ' -Djava.io.tmpdir=' ~ nexus_temp_dir) }}"
{% for key, value in nexus_docker_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}

    # ── Ports (explicit, for documentation) ──
    # Nexus UI/API:      {{ nexus_port }}:8081
{% if nexus_https_enabled %}
    # Nexus HTTPS:       {{ nexus_https_port }}:8443
{% endif %}

    # ── Resource Limits ──
{% if nexus_docker_memory_limit | default('') | length > 0 %}
    mem_limit: "{{ nexus_docker_memory_limit }}"
{% endif %}
{% if nexus_docker_memswap_limit | default('') | length > 0 %}
    memswap_limit: "{{ nexus_docker_memswap_limit }}"
{% endif %}
{% if nexus_docker_cpus | default('') | length > 0 %}
    cpus: {{ nexus_docker_cpus }}
{% endif %}
{% if nexus_docker_cpu_shares | default(0) | int > 0 %}
    cpu_shares: {{ nexus_docker_cpu_shares }}
{% endif %}
{% if nexus_docker_privileged | default(false) %}
    privileged: true
{% endif %}

    # ── Health Check ──
{% if nexus_docker_healthcheck_enabled %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081{{ nexus_api_health_path }}"]
      interval: "{{ nexus_docker_healthcheck_interval }}s"
      timeout: "{{ nexus_docker_healthcheck_timeout }}s"
      retries: {{ nexus_docker_healthcheck_retries }}
      start_period: "{{ nexus_docker_healthcheck_start_period }}s"
{% endif %}

    # ── Logging ──
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"

    # ── Labels ──
    labels:
      com.nexus.managed-by: "ansible"
      com.nexus.version: "{{ nexus_version }}"
      com.nexus.edition: "{{ nexus_edition }}"
