#!/bin/bash
# roles/backup/templates/nexus-backup.sh.j2
set -e

BACKUP_DIR="/var/backups/nexus"
NEXUS_DATA="{{ nexus.data_dir }}"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_FILE="nexus-backup-${TIMESTAMP}.tar.gz"
DESTINATION="{{ features.backup.destination }}"

echo "[$(date)] Starting Nexus backup process..."

# 1. Create a versioned tarball of the data directory (includes DB, config, and local blobs)
# Note: In a production environment with massive local blobstores, rsync is preferred.
# For MVP, tarring the volume ensures metadata and configuration are safely captured.
echo "[$(date)] Archiving $NEXUS_DATA to $BACKUP_DIR/$BACKUP_FILE"
tar -czf "$BACKUP_DIR/$BACKUP_FILE" -C "$(dirname "$NEXUS_DATA")" "$(basename "$NEXUS_DATA")"

# 2. Upload to external storage if configured
if [ "$DESTINATION" == "s3" ] || [ "$DESTINATION" == "minio" ]; then
    echo "[$(date)] Uploading to $DESTINATION..."
    
    export AWS_ACCESS_KEY_ID="{{ features.backup.access_key }}"
    export AWS_SECRET_ACCESS_KEY="{{ features.backup.secret_key }}"
    export AWS_DEFAULT_REGION="{{ features.backup.region | default('us-east-1') }}"
    
    ENDPOINT_ARG=""
    if [ "$DESTINATION" == "minio" ]; then
        ENDPOINT_ARG="--endpoint-url {{ features.backup.endpoint }}"
    fi
    
    aws s3 cp "$BACKUP_DIR/$BACKUP_FILE" "s3://{{ features.backup.bucket }}/" $ENDPOINT_ARG
    
    echo "[$(date)] Upload complete."
fi

# 3. Clean up old local backups based on retention policy
echo "[$(date)] Cleaning up local backups older than {{ features.backup.retention_days }} days..."
find "$BACKUP_DIR" -type f -name "nexus-backup-*.tar.gz" -mtime +{{ features.backup.retention_days }} -exec rm {} \;

echo "[$(date)] Backup process finished successfully."
